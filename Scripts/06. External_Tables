-- External tables without Metadata -- Mannually

List @Azure_Ext_Stg_New/Courses_Data;

Select $1, $2,$3 from @Azure_Ext_Stg_New/Courses_Data;

-- Extract Columns
Select 
    VALUE:c1::varchar as "CourseName",
    VALUE:c2::varchar as "Trainer",
    METADATA$FILENAME
from my_ext_tbl;



-- Method 2 

-- Make table with columns from External files Mannually

CREATE OR REPLACE EXTERNAL TABLE tbl_w_cols
    (
        C11 varchar AS (VALUE:c1::varchar),
        C22 varchar AS (VALUE:c2::varchar)
    )
    location = @Azure_Ext_Stg_New
    AUTO_REFRESH = FALSE
    file_format = CSV_FORMAT_NEW;

Select C11,C22 from tbl_w_cols;

-- See Filenames as well
Select C1,C2, METADATA$FILENAME from tbl_w_cols;


-- METHOD 3

-- Evolving Schema Handling -- BEST

-- First Check Schema at Stage using INFER_SCHEMA

SELECT *
FROM TABLE(
    INFER_SCHEMA(
        LOCATION => '@Azure_Ext_Stg_New/SchemaEvolution/',
        FILE_FORMAT => 'CSV_FORMAT_NEW'
    )
);

-- Second make -- External Table dynamically using USING TEMPLATE

CREATE OR REPLACE EXTERNAL TABLE EXT_EMPLOYEE_DYNAMIC
USING TEMPLATE
(
    SELECT ARRAY_AGG(OBJECT_CONSTRUCT(*))
        FROM TABLE(
            INFER_SCHEMA(
                LOCATION => '@Azure_Ext_Stg_New/SchemaEvolution/',
                FILE_FORMAT => 'CSV_FORMAT_NEW'
            )
        )
)
-- INTEGRATION = Azure_Notification_Int_v55
LOCATION = @Azure_Ext_Stg_New/SchemaEvolution/,
FILE_FORMAT = CSV_FORMAT_NEW
AUTO_REFRESH = FALSE;

Select * from EXT_EMPLOYEE_DYNAMIC;



DESC EXTERNAL TABLE EXT_EMPLOYEE_DYNAMIC;


SELECT
    CourseName,
    Trainer,
    METADATA$FILENAME AS SOURCE_FILE
FROM EXT_EMPLOYEE_DYNAMIC;


-- Enable AUTO_REFRESH with Azure Notification Integration -- enable automatic file metadata refresh.

-- ISSUE -- Add / Remove CSV Columns

-- CSV Inference didn't worked

-- NOTE 
-- For CSV files, schema inference uses PARSE_HEADER = TRUE to detect column names from the header row.

CREATE OR REPLACE FILE FORMAT CSV_INFER_FORMAT
    TYPE = CSV
    PARSE_HEADER = TRUE
    FIELD_OPTIONALLY_ENCLOSED_BY = '"';

-- Use to Infer schema

SELECT *
FROM TABLE(
    INFER_SCHEMA(
        LOCATION => '@Azure_Ext_Stg_New/SchemaEvolution/',
        FILE_FORMAT => 'CSV_INFER_FORMAT'
    )
);

-- For the external table itself, use a separate CSV file format with SKIP_HEADER = 1, because PARSE_HEADER isn't supported for external tables.

CREATE OR REPLACE FILE FORMAT CSV_EXT_FORMAT
    TYPE = CSV
    SKIP_HEADER = 1
    FIELD_OPTIONALLY_ENCLOSED_BY = '"';


CREATE OR REPLACE EXTERNAL TABLE EXT_EMPLOYEE_DYNAMIC
USING TEMPLATE
(
    SELECT ARRAY_AGG(OBJECT_CONSTRUCT(*))
        FROM TABLE(
            INFER_SCHEMA(
                LOCATION => '@Azure_Ext_Stg_New/SchemaEvolution/',
                FILE_FORMAT => 'CSV_INFER_FORMAT'
            )
        )
)
-- INTEGRATION = Azure_Notification_Int_v55
LOCATION = @Azure_Ext_Stg_New/SchemaEvolution/,
FILE_FORMAT = CSV_EXT_FORMAT
AUTO_REFRESH = FALSE;

Select * from EXT_EMPLOYEE_DYNAMIC;

SELECT
    CourseName,
    Trainer,
    METADATA$FILENAME AS SOURCE_FILE
FROM EXT_EMPLOYEE_DYNAMIC;
